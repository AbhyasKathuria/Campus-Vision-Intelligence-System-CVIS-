# ==============================================================================
# CVIS — Campus Vision Intelligence System
# Environment Configuration Template
# ==============================================================================

# General
ENVIRONMENT=development
LOG_LEVEL=INFO
PROJECT_NAME="Campus Vision Intelligence System (CVIS)"

# Database (PostgreSQL)
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=cvis_user
POSTGRES_PASSWORD=cvis_secure_pass
POSTGRES_DB=cvis_db
DATABASE_URL=postgresql+asyncpg://cvis_user:cvis_secure_pass@postgres:5432/cvis_db
SYNC_DATABASE_URL=postgresql://cvis_user:cvis_secure_pass@postgres:5432/cvis_db

# Redis (Cache, Celery Broker, Rate Limiting)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Security & Authentication
JWT_SECRET=super_secret_jwt_key_cvis_university_32bytes_min!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ML Inference Microservice
ML_SERVICE_URL=http://ml-service:8001
ML_TIMEOUT_SECONDS=30

# Storage
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=/data/storage
MAX_UPLOAD_SELFIE_MB=10
MAX_UPLOAD_BULK_ZIP_MB=500
MAX_UPLOAD_VIDEO_MB=200

# Rate Limiting
RATE_LIMIT_LOGIN="5/minute"
RATE_LIMIT_SELFIE_SEARCH="10/minute"
RATE_LIMIT_BULK_UPLOAD="5/minute"

# Compliance & Ingestion Defaults
DEFAULT_CAMERA_CADENCE_SECONDS=2.0
DEFAULT_RETENTION_DAYS=30
SIMILARITY_THRESHOLD=0.65
TELEMETRY_MIN_SAMPLE_SIZE=10
